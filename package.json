{
  "name": "americas",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "yarn node src/index.ts",
    "create-round": "yarn node src/create-round.ts",
    "submit-round": "yarn node src/submit-round.ts",
    "end-round": "yarn node src/end-round.ts",
    "send-reminders": "yarn node src/send-reminders.ts",
    "leaderboard": "yarn node src/leaderboard.ts",
    "list-countries": "yarn node src/list-countries.ts",
    "typecheck": "tsc --noEmit",
    "test": "yarn node --test --import ./tests/setup.ts 'tests/**/*.test.ts'",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepare": "husky",
    "build-kml": "yarn node src/kml.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@tsconfig/node24": "24.0.5",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@js-joda/core": "6.1.0",
    "@js-joda/timezone": "2.25.2",
    "@ngageoint/geopackage": "4.2.9",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/distance": "7.4.0",
    "fflate": "0.8.3",
    "geographiclib-dms": "2.2.0",
    "xmlbuilder2": "4.0.3"
  },
  "resolutions": {
    "better-sqlite3": "13.0.3"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  }
}
